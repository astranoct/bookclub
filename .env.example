# Appwrite project ID (Appwrite console > Settings). Not a secret, but keep it configurable.
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
# API endpoint shown next to the project ID (it can be regional, e.g. https://sfo.cloud.appwrite.io/v1).
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# Must match the platform registered in Appwrite (the Android package name).
EXPO_PUBLIC_APPWRITE_PLATFORM=com.boosterlong.bookclub
