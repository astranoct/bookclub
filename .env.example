# Appwrite project ID (Appwrite console > Settings). Not a secret, but keep it configurable.
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
# API endpoint shown next to the project ID (it can be regional, e.g. https://sfo.cloud.appwrite.io/v1).
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# Must match the platform registered in Appwrite (the Android package name).
EXPO_PUBLIC_APPWRITE_PLATFORM=com.boosterlong.bookclub
# Optional. Where display names are stored (see README: Appwrite setup). These are the defaults.
EXPO_PUBLIC_APPWRITE_DATABASE_ID=bookclub
EXPO_PUBLIC_APPWRITE_PROFILES_COLLECTION_ID=profiles
EXPO_PUBLIC_APPWRITE_PROGRESS_COLLECTION_ID=progress
EXPO_PUBLIC_APPWRITE_SUGGESTIONS_COLLECTION_ID=suggestions
# Optional. Where invite emails send people. Defaults to this app's own deep link, but Appwrite
# only allows hosts registered as platforms. If sending an invite is rejected, register a Web
# platform and set this to e.g. https://your-host/invite (members can then paste the link in the app).
EXPO_PUBLIC_INVITE_URL=
